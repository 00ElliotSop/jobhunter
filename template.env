# ============================================================
# .env — NEVER commit this file to GitHub
# Copy this to .env and fill in your values
# ============================================================

# Claude API (get at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX

# USAJobs API (register free at usajobs.gov/developer)
USAJOBS_API_KEY=your_usajobs_key
USAJOBS_EMAIL=your@email.com

# Adzuna API (register free at developer.adzuna.com)
ADZUNA_API_KEY=your_adzuna_key
ADZUNA_APP_ID=your_adzuna_app_id

# LinkedIn (your actual login — used by Playwright)
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# Email / SMTP (your existing Mailcow)
SMTP_USER=jobhunter@email.com
SMTP_PASS=your_mailcow_password

# Email address that receives notifications (and sends replies)
NOTIFY_EMAIL=your@email.com

# Database path
DB_PATH=./data/jobhunter.db

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
